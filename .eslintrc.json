{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": ["airbnb-base", "prettier"],
  "plugins": ["prettier"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "prettier/prettier": [
      "error",
      {
        "singleQuote": false,
        "tabWidth": 2,
        "endOfLine": "auto",
        "trailingComma": "none",
        "bracketSpacing": true
      }
    ],
    "linebreak-style": ["error", "windows"],
    "import/extensions": "off",
    "consistent-return": "off",
    "object-shorthand": "off",
    "camelcase": "error",
    "no-unused-vars": "warn"
  }
}
